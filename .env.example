# Copy to .env for local overrides. Do not put real secrets in git.
PORT=8787
# Leave empty to use the embedded Postgres-compatible database in ./data/budgetcents.
DATABASE_URL=
BUDGETCENTS_DATA=./data/budgetcents
BUDGETCENTS_UPLOADS=./data/uploads
BUDGETCENTS_WEB=./apps/web/dist
NODE_ENV=development
# Sample household sign-in. Set false in any shared deployment.
DEMO_LOGIN=true
SEED_DEMO=true
# When true, password-reset and verification tokens are returned by the API.
# Keep this false outside a private development machine.
ALLOW_DEV_MAILSINK=false
# SMTP URL for real mail. Until it is set, messages stay in the local outbox.
SMTP_URL=

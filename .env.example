# Copy to .env for local overrides. Do not put real secrets in git.
PORT=8787
# Leave empty to use the embedded Postgres-compatible database in ./data/budgetcents.
DATABASE_URL=
BUDGETCENTS_DATA=./data/budgetcents
BUDGETCENTS_UPLOADS=./data/uploads
BUDGETCENTS_WEB=./apps/web/dist
NODE_ENV=development
# Sample household sign-in. Set false in any shared deployment.
DEMO_LOGIN=true
SEED_DEMO=true
# When true, password-reset and verification tokens are returned by the API.
# Keep this false outside a private development machine.
ALLOW_DEV_MAILSINK=false
# Public HTTPS address used in account and alert mail.
BUDGETCENTS_PUBLIC_URL=
# Enable only after configuring a verified sender. Old outbox rows stay local.
BUDGETCENTS_MAIL_ENABLED=false
# Recommended on Railway: HTTPS works without the Pro SMTP upgrade.
RESEND_API_KEY=
RESEND_FROM=
# Alternative transport, used only when RESEND_API_KEY is empty.
SMTP_URL=
SMTP_FROM=
# 32 random bytes as 64 hex characters; server only. Back up with encrypted data.
BUDGETCENTS_PROVIDER_KEY=
# Personal-use U.S. stock/ETF quotes. Server only; provider licensing applies.
FINNHUB_API_KEY=
BUDGETCENTS_PUSH_ENABLED=false
# Server service account. NEVER include this JSON in the Android build.
FCM_SERVICE_ACCOUNT_JSON=
# Public Firebase Android configuration; set in the Gradle build environment.
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_SENDER_ID=
